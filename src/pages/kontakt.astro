---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import kontakt from '../data/kontakt.json';
const telHref = '+' + kontakt.telefon.replace(/\D/g, '').replace(/^00/, '');
const spec = (await getCollection('specijalnosti')).sort((a, b) => (a.data.broj ?? 99) - (b.data.broj ?? 99));
---
<Base
  title={'Kontakt — Poliklinika Vallis Medica'}
  description={'Kontaktirajte Polikliniku Vallis Medica — Božidarevićeva 7, Zagreb. Telefon +385 1 2305 444.'}
>
  <div class="page-hero">
    <div class="container">
      <p class="crumb"><a href="/">Početna</a> / Kontakt</p>
      <h1>Kontakt</h1>
      <p class="tagline">Pošaljite upit ili nas nazovite</p>
    </div>
  </div>

  <section>
    <div class="container contact-grid">
      <div class="cinfo">
        <div class="ci">
          <div class="icon"><svg viewBox="0 0 384 512"><path d="M172.3 501.7C27 291 0 269.4 0 192 0 86 86 0 192 0s192 86 192 192c0 77.4-27 99-172.3 309.7-9.5 13.8-29.9 13.8-39.4 0zM192 272c44.2 0 80-35.8 80-80s-35.8-80-80-80-80 35.8-80 80 35.8 80 80 80z"/></svg></div>
          <div><h4>Sjedište</h4><p>{kontakt.adresa}</p></div>
        </div>
        <div class="ci">
          <div class="icon"><svg viewBox="0 0 512 512"><path d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"/></svg></div>
          <div><h4>Telefon / Fax</h4><p><a href={`tel:${telHref}`}>{kontakt.telefon_display}</a></p></div>
        </div>
        <div class="ci">
          <div class="icon"><svg viewBox="0 0 512 512"><path d="M464 64H48C21.5 64 0 85.5 0 112v288c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48zm0 48v40.8c-22.4 18.3-58.2 46.7-134.6 106.5-16.8 13.2-50.2 45.1-73.4 44.7-23.2.4-56.6-31.5-73.4-44.7C106.2 199.5 70.4 171.1 48 152.8V112h416zM48 400V214.4c22.9 18.3 55.4 43.9 104.9 82.6 21.9 17.2 60.1 55.2 103.1 55 42.7.2 80.5-37.2 103.1-55 49.5-38.7 82-64.4 104.9-82.6V400H48z"/></svg></div>
          <div><h4>E-mail</h4><p><a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></p></div>
        </div>
        <div class="hours-card" style="margin-top:6px">
          <h3>Radno vrijeme</h3>
          <table>
            {kontakt.radno_vrijeme.map((r) => (<tr><td>{r.dan}</td><td>{r.sat}</td></tr>))}
          </table>
        </div>
      </div>
      <div>
        <form class="contact-form" data-mailto={kontakt.email} data-subject="Upit s web stranice — Vallis Medica">
          <label for="ime">Ime i prezime *</label>
          <input type="text" id="ime" name="Ime i prezime" required autocomplete="name" />
          <label for="email">E-mail *</label>
          <input type="email" id="email" name="E-mail" required autocomplete="email" />
          <label for="tel">Telefon</label>
          <input type="tel" id="tel" name="Telefon" autocomplete="tel" />
          <label for="usluga">Usluga</label>
          <select id="usluga" name="Usluga">
            <option value="">— Odaberite —</option>
            {spec.map((s) => (<option>{s.data.naslov}</option>))}
          </select>
          <label for="poruka">Poruka *</label>
          <textarea id="poruka" name="Poruka" required></textarea>
          <button type="submit" class="btn btn-primary">Pošalji</button>
          <p class="form-note">Slanjem se otvara vaš e-mail program s pripremljenom porukom.</p>
        </form>
        <iframe class="map-embed" loading="lazy" title="Karta — Božidarevićeva 7, Zagreb" src="https://maps.google.com/maps?q=Bo%C5%BEidarevi%C4%87eva%207%2C%2010000%20Zagreb&t=&z=15&ie=UTF8&iwloc=&output=embed"></iframe>
      </div>
    </div>
  </section>
</Base>
