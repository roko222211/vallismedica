---
import Base from '../layouts/Base.astro';
import kontakt from '../data/kontakt.json';
const telHref = '+' + kontakt.telefon.replace(/\D/g, '').replace(/^00/, '');
---
<Base
  title={'O nama — Poliklinika Vallis Medica'}
  description={'Poliklinika Vallis Medica osnovana je 1998. godine — višegodišnja tradicija kvalitete usluge i predanosti pacijentu.'}
>
  <div class="page-hero">
    <div class="container">
      <p class="crumb"><a href="/">Početna</a> / O nama</p>
      <h1>O nama</h1>
      <p class="tagline">S Vama od 1998.</p>
    </div>
  </div>

  <section>
    <div class="container split">
      <div>
        <span class="kicker">O nama</span>
        <h2 class="section-title">Poliklinika Vallis Medica</h2>
        <p class="section-lead">Poliklinika Vallis Medica osnovana je 1998. godine. Njezina višegodišnja tradicija govori o kvaliteti usluge i predanosti pacijentu.</p>
        <p class="section-lead" style="margin-top:12px">O vašem zdravlju brinu renomirani liječnici iz najboljih zdravstvenih ustanova.</p>
        <div class="feature-row"><span class="dot"></span><p><strong>Briga i skrb</strong> za naše pacijente.</p></div>
        <div class="feature-row"><span class="dot"></span><p><strong>Stručni pregledi</strong>, mišljenja i dijagnoze.</p></div>
        <div class="feature-row"><span class="dot"></span><p><strong>Pratimo najnovije tehnologije</strong> u medicini.</p></div>
      </div>
      <div class="hours-card">
        <h3>Radno vrijeme</h3>
        <table>
          {kontakt.radno_vrijeme.map((r) => (<tr><td>{r.dan}</td><td>{r.sat}</td></tr>))}
        </table>
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="cta-band">
      <div class="container">
        <h2>Naručite se</h2>
        <p>Nazovite <a href={`tel:${telHref}`}>{kontakt.telefon_display}</a> ili ispunite obrazac za naručivanje.</p>
        <a class="btn" href="/narucivanje">Naručivanje</a>
      </div>
    </div>
  </section>
</Base>
