---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import kontakt from '../data/kontakt.json';

const spec = (await getCollection('specijalnosti')).sort(
  (a, b) => (a.data.broj ?? 99) - (b.data.broj ?? 99)
);
const telHref = '+' + kontakt.telefon.replace(/\D/g, '').replace(/^00/, '');
---
<Base
  title={'Poliklinika Vallis Medica — S Vama od 1998.'}
  description={'Poliklinika Vallis Medica, Zagreb — 14 specijalističkih ordinacija i renomirani liječnici iz najboljih zdravstvenih ustanova u Hrvatskoj. S Vama od 1998.'}
>
<!-- HERO -->
<section class="hero">
  <div class="container">
    <h1>Poliklinika Vallis Medica</h1>
    <p class="sub">S Vama od 1998.</p>
  </div>
</section>

<!-- USLUGE -->
<section id="usluge">
  <div class="container">
    <div class="fgrid">
      {spec.map((s) => (
        <a class="fbox" href={`/specijalnosti/${s.id}`}>
          <i class={s.data.ikona} aria-hidden="true"></i>
          <div>
            <h3>{s.data.naslov}</h3>
            <p>{s.data.kratki}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- O NAMA -->
<section style="padding-top:0">
  <div class="container split">
    <div>
      <span class="kicker">O nama</span>
      <h2 class="section-title">Višegodišnja tradicija kvalitete</h2>
      <p class="section-lead">Poliklinika Vallis Medica osnovana je 1998. godine. Njezina višegodišnja tradicija govori o kvaliteti usluge i predanosti pacijentu. O vašem zdravlju brinu renomirani liječnici iz najboljih zdravstvenih ustanova.</p>
      <div class="feature-row"><span class="dot"></span><p><strong>Briga i skrb</strong> za naše pacijente.</p></div>
      <div class="feature-row"><span class="dot"></span><p><strong>Stručni pregledi</strong>, mišljenja i dijagnoze.</p></div>
      <div class="feature-row"><span class="dot"></span><p><strong>Pratimo najnovije tehnologije</strong> u medicini.</p></div>
      <p style="margin-top:24px"><a class="btn btn-primary" href="/o-nama">Više o nama</a></p>
    </div>
    <img src="/images/about-us/ultra1.jpg" alt="Ultrazvučna dijagnostika u Poliklinici Vallis Medica" />
  </div>
</section>

<!-- CTA -->
<section style="padding-top:0">
  <div class="cta-band">
    <div class="container">
      <h2>Naručite se na pregled</h2>
      <p>Nazovite <a href={`tel:${telHref}`}>{kontakt.telefon_display}</a> ili pišite na <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></p>
      <a class="btn" href="/narucivanje">Naručivanje</a>
    </div>
  </div>
</section>
</Base>
