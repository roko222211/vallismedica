---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const spec = (await getCollection('specijalnosti')).sort(
  (a, b) => (a.data.broj ?? 99) - (b.data.broj ?? 99)
);
---
<Base
  title={'Specijalnosti — Poliklinika Vallis Medica'}
  description={'Sve specijalističke ordinacije Poliklinike Vallis Medica — ginekologija, kardiologija, ortopedija, neurologija, dentalna medicina i više.'}
>
  <div class="phero">
    <div class="container">
      <p class="crumb"><a href="/">Početna</a> — Specijalnosti</p>
      <h1>Specijalnosti</h1>
      <p class="tagline">Četrnaest ordinacija pod jednim krovom.</p>
    </div>
  </div>

  <section class="reg-sec">
    <div class="container">
      <div class="reg" style="border-top:0">
        {spec.map((s) => (
          <a class="reg-item" href={`/specijalnosti/${s.id}`}>
            <span class="reg-num">{String(s.data.broj ?? 0).padStart(2, '0')}</span>
            <span class="reg-name">{s.data.naslov}</span>
            <span class="reg-desc">{s.data.kratki}</span>
            <span class="reg-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
