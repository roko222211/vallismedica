---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const spec = (await getCollection('specijalnosti')).sort(
  (a, b) => (a.data.broj ?? 99) - (b.data.broj ?? 99)
);
---
<Base
  title={'Usluge — Poliklinika Vallis Medica'}
  description={'Specijalističke ordinacije Poliklinike Vallis Medica — ginekologija, kardiologija, ortopedija, neurologija, dentalna medicina i više.'}
>
  <div class="page-hero">
    <div class="container">
      <p class="crumb"><a href="/">Početna</a> / Usluge</p>
      <h1>Naše usluge</h1>
      <p class="tagline">Četrnaest specijalističkih ordinacija pod jednim krovom.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="fgrid">
        {spec.map((s) => (
          <a class="fbox" href={`/specijalnosti/${s.id}`}>
            <i class={s.data.ikona} aria-hidden="true"></i>
            <div>
              <h3>{s.data.naslov}</h3>
              <p>{s.data.kratki}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
