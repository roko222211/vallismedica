---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import kontakt from '../../data/kontakt.json';

export async function getStaticPaths() {
  const items = await getCollection('specijalnosti');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const telHref = '+' + kontakt.telefon.replace(/\D/g, '').replace(/^00/, '');
---
<Base
  title={`${d.naslov} — Poliklinika Vallis Medica`}
  description={`${d.naslov} — ${d.kratki}. Poliklinika Vallis Medica, Zagreb.`}
>
  <div class="page-hero">
    <div class="container">
      <p class="crumb"><a href="/">Početna</a> / <a href="/#usluge">Usluge</a></p>
      <h1>{d.naslov}</h1>
      {d.kratki && <p class="tagline">{d.kratki}</p>}
    </div>
  </div>

  <section>
    <div class="container">
      <div class="prose" style="margin-bottom:26px"><Content /></div>
      <span class="kicker">Usluge</span>
      <h2 class="section-title">Što nudimo</h2>
      <div class="usluge-list">
        {d.usluge.map((u) => (
          <div class="usluga"><span class="check">✓</span><div><b>{u}</b></div></div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0">
    <div class="cta-band">
      <div class="container">
        <h2>Naručite se</h2>
        <p>Nazovite <a href={`tel:${telHref}`}>{kontakt.telefon_display}</a> ili ispunite obrazac za naručivanje.</p>
        <a class="btn" href="/narucivanje">Naručivanje</a>
      </div>
    </div>
  </section>
</Base>
