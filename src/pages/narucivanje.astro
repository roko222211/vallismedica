---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import kontakt from '../data/kontakt.json';

const spec = (await getCollection('specijalnosti')).sort(
  (a, b) => (a.data.broj ?? 99) - (b.data.broj ?? 99)
);
---
<Base
  title={'Naručivanje — Poliklinika Vallis Medica'}
  description={'Naručite se na pregled u Polikliniku Vallis Medica — obrazac za naručivanje ili telefon +385 1 2305 444.'}
>
  <div class="phero">
    <div class="container">
      <p class="crumb"><a href="/">Početna</a> · Naručivanje</p>
      <h1>Naručivanje</h1>
      <p class="tagline">Rezervirajte svoj termin</p>
    </div>
  </div>

  <section>
    <div class="container form-grid">
      <div class="cinfo">
        <div class="row">
          <span class="ic"><svg viewBox="0 0 512 512"><path d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"/></svg></span>
          <div><h4>Naručivanje telefonom</h4><p><a href={`tel:${kontakt.telefon.replace(/\s/g, '')}`}>{kontakt.telefon_display}</a></p></div>
        </div>
        <div class="row">
          <span class="ic"><svg viewBox="0 0 512 512"><path d="M464 64H48C21.49 64 0 85.49 0 112v288c0 26.51 21.49 48 48 48h416c26.51 0 48-21.49 48-48V112c0-26.51-21.49-48-48-48zm0 48v40.805c-22.422 18.259-58.168 46.651-134.587 106.49-16.841 13.247-50.201 45.072-73.413 44.701-23.208.375-56.579-31.459-73.413-44.701C106.18 199.465 70.425 171.067 48 152.805V112h416zM48 400V214.398c22.914 18.251 55.409 43.862 104.938 82.646 21.857 17.205 60.134 55.186 103.062 54.955 42.717.231 80.509-37.199 103.053-54.947 49.528-38.783 82.032-64.401 104.947-82.653V400H48z"/></svg></span>
          <div><h4>Naručivanje e-mailom</h4><p><a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></p></div>
        </div>
        <div class="row">
          <span class="ic"><svg viewBox="0 0 384 512"><path d="M172.268 501.67C26.97 291.031 0 269.413 0 192 0 85.961 85.961 0 192 0s192 85.961 192 192c0 77.413-26.97 99.031-172.268 309.67-9.535 13.774-29.93 13.773-39.464 0zM192 272c44.183 0 80-35.817 80-80s-35.817-80-80-80-80 35.817-80 80 35.817 80 80 80z"/></svg></span>
          <div><h4>Lokacija</h4><p>{kontakt.adresa}</p></div>
        </div>
      </div>
      <form class="form" data-mailto={kontakt.email} data-subject="Naručivanje — Poliklinika Vallis Medica">
        <label for="ime">Ime i prezime *</label>
        <input type="text" id="ime" name="Ime i prezime" required autocomplete="name" />
        <label for="tel">Kontakt telefon *</label>
        <input type="tel" id="tel" name="Telefon" required autocomplete="tel" />
        <label for="email">E-mail adresa</label>
        <input type="email" id="email" name="E-mail" autocomplete="email" />
        <label for="pregled">Pregled za *</label>
        <select id="pregled" name="Pregled za" required>
          <option value="">— Odaberite —</option>
          {spec.map((s) => (<option>{s.data.naslov}</option>))}
        </select>
        <label for="datum">Željeni datum</label>
        <input type="date" id="datum" name="Željeni datum" />
        <label for="prije">Već ste bili kod nas?</label>
        <select id="prije" name="Već kod nas">
          <option>Ne</option>
          <option>Da</option>
        </select>
        <label for="napomena">Napomena</label>
        <textarea id="napomena" name="Napomena"></textarea>
        <button type="submit" class="cta">Pošalji zahtjev <span class="arw">→</span></button>
        <p class="note">Termin je potvrđen tek nakon našeg odgovora.</p>
      </form>
    </div>
  </section>
</Base>
