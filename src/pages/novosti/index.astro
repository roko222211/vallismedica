---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate as fmt } from '../../lib/date';

const items = (await getCollection('novosti')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---
<Base
  title={'Novosti — Poliklinika Vallis Medica'}
  description={'Novosti i obavijesti Poliklinike Vallis Medica — termini, usluge i događanja.'}
>
  <div class="page-hero">
    <div class="container">
      <p class="crumb"><a href="/">Početna</a> / Novosti</p>
      <h1>Novosti</h1>
    </div>
  </div>

  <section>
    <div class="container">
      {items.length === 0 ? (
        <p style="color:#666">Trenutno nema objavljenih novosti.</p>
      ) : (
        <div class="news-list">
          {items.map((item) => (
            <a class="news-item" href={`/novosti/${item.id}`}>
              <span class="date">{fmt(item.data.date)}</span>
              <h3>{item.data.title}</h3>
              {item.data.summary && <p>{item.data.summary}</p>}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
