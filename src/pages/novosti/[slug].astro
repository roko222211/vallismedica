---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate as fmt } from '../../lib/date';

export async function getStaticPaths() {
  const items = await getCollection('novosti');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---
<Base title={`${item.data.title} — Vallis Medica`} description={item.data.summary}>
  <div class="page-hero">
    <div class="container">
      <p class="crumb"><a href="/">Početna</a> / <a href="/novosti">Novosti</a></p>
      <h1>{item.data.title}</h1>
      <p class="date">{fmt(item.data.date)}</p>
    </div>
  </div>

  <section>
    <div class="container">
      {item.data.coverImage && (
        <img src={item.data.coverImage} alt={item.data.title} style="max-width:820px;box-shadow:var(--shadow);margin-bottom:26px" />
      )}
      <div class="prose"><Content /></div>
      <p style="margin-top:30px"><a class="btn btn-primary" href="/novosti">← Sve novosti</a></p>
    </div>
  </section>
</Base>
