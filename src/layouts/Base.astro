---
import { getCollection } from 'astro:content';
import obavijest from '../data/obavijest.json';
import kontakt from '../data/kontakt.json';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = '', noindex = false } = Astro.props;

const specijalnosti = (await getCollection('specijalnosti')).sort(
  (a, b) => (a.data.broj ?? 99) - (b.data.broj ?? 99)
);

const telHref = (s: string): string => {
  const d = (s || '').replace(/\D/g, '');
  return d ? '+' + d.replace(/^00/, '') : '';
};

const dismissKey = (() => {
  const s = obavijest?.tekst || '';
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return 'vm-obav-' + h;
})();
---
<!DOCTYPE html>
<html lang="hr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/images/logo-medical.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/style.css" />
</head>
<body>

{obavijest?.aktivna && (
  <div class="announce" id="announce">
    <div class="container">
      {obavijest.oznaka && <span class="tag">{obavijest.oznaka}</span>}
      <span>
        {obavijest.tekst}
        {obavijest.telefon && (<> <a href={`tel:${telHref(obavijest.telefon)}`}>{obavijest.telefon}</a></>)}
      </span>
      <button class="x" id="announceX" aria-label="Zatvori">&#10005;</button>
    </div>
  </div>
)}

<header class="mast">
  <div class="container bar">
    <a class="wordmark" href="/">
      <img src="/images/logo-medical@2x.png" alt="Poliklinika Vallis Medica" />
    </a>
    <button class="burger" aria-label="Izbornik" aria-expanded="false"
      onclick="const n=document.getElementById('nav');n.classList.toggle('open');this.setAttribute('aria-expanded',n.classList.contains('open'))">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="nav" aria-label="Glavna navigacija">
      <div><a href="/">Početna</a></div>
      <div>
        <a href="/#specijalnosti">Specijalnosti ▾</a>
        <div class="drop">
          {specijalnosti.map((s) => (
            <a href={`/specijalnosti/${s.id}`}>
              <span class="idx">{String(s.data.broj ?? 0).padStart(2, '0')}</span>{s.data.naslov}
            </a>
          ))}
        </div>
      </div>
      <div><a href="/o-nama">O nama</a></div>
      <div><a href="/novosti">Novosti</a></div>
      <div><a href="/kontakt">Kontakt</a></div>
      <div class="book"><a href="/narucivanje">Naručivanje</a></div>
    </nav>
  </div>
</header>

<slot />

<footer class="ft">
  <div class="container cols">
    <div>
      <img src="/images/foot-widget-logo.png" alt="Poliklinika Vallis Medica" />
      <p><strong>Sjedište:</strong><br />{kontakt.adresa}</p>
      <p><strong>Tel / Fax:</strong> <a href={`tel:${telHref(kontakt.telefon)}`}>{kontakt.telefon_display}</a></p>
      <p><strong>E-mail:</strong> <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a></p>
    </div>
    <div class="links">
      <h4>Sadržaj</h4>
      <a href="/#specijalnosti">Specijalnosti</a>
      <a href="/o-nama">O nama</a>
      <a href="/novosti">Novosti</a>
      <a href="/kontakt">Kontakt</a>
      <a href="/narucivanje">Naručivanje</a>
    </div>
    <div>
      <h4>S Vama od 1998.</h4>
      <p>Poliklinika pruža usluge renomiranih liječnika iz najboljih zdravstvenih ustanova u Hrvatskoj — od ginekologije i kardiologije do dentalne medicine.</p>
    </div>
  </div>
  <div class="container base">
    <span>© <span id="god"></span> Poliklinika Vallis Medica</span>
    <span>{kontakt.adresa_kratko}</span>
  </div>
</footer>

<script is:inline define:vars={{ dismissKey }}>
  (function () {
    var a = document.getElementById('announce');
    if (a) {
      try { if (localStorage.getItem(dismissKey) === '1') a.remove(); } catch (e) {}
      var x = document.getElementById('announceX');
      if (x) x.addEventListener('click', function () {
        a.remove();
        try { localStorage.setItem(dismissKey, '1'); } catch (e) {}
      });
    }
  })();
  var g = document.getElementById('god');
  if (g) g.textContent = new Date().getFullYear();
</script>

<script is:inline>
  // Reveal-on-scroll
  (function () {
    var els = [].slice.call(document.querySelectorAll('.reveal'));
    if (!els.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!('IntersectionObserver' in window) || reduce.matches) {
      els.forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();

  // Zatvori mobilni izbornik na klik linka / resize
  (function () {
    var nav = document.getElementById('nav');
    if (!nav) return;
    var burger = document.querySelector('.burger');
    function close() { nav.classList.remove('open'); if (burger) burger.setAttribute('aria-expanded', 'false'); }
    nav.querySelectorAll('a').forEach(function (a) {
      if (!a.getAttribute('href') || a.getAttribute('href').indexOf('#') === -1) a.addEventListener('click', close);
    });
    window.addEventListener('resize', function () { if (window.innerWidth > 760) close(); });
  })();

  // Obrasci -> mailto (naručivanje / kontakt / newsletter)
  (function () {
    document.querySelectorAll('form[data-mailto]').forEach(function (form) {
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var to = form.getAttribute('data-mailto');
        var subj = form.getAttribute('data-subject') || 'Upit s web stranice';
        var f = new FormData(form);
        var lines = [];
        f.forEach(function (v, k) { if (k !== 'email' || v) lines.push(k + ': ' + (v || '-')); });
        location.href = 'mailto:' + to + '?subject=' + encodeURIComponent(subj) + '&body=' + encodeURIComponent(lines.join('\n'));
      });
    });
  })();
</script>
</body>
</html>
